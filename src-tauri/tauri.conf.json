{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monii Watch",
  "version": "0.7.6",
  "identifier": "com.moniiwatch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monii Watch",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "category": "Finance",
    "shortDescription": "Envelope budgeting that syncs peer-to-peer.",
    "longDescription": "Monii Watch is a privacy-first envelope budgeting app inspired by YNAB. All data is stored locally on your device and syncs peer-to-peer with WebRTC — no servers, no accounts.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0",
      "developmentTeam": null,
      "frameworks": []
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/JordanC93/monii-watch/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NjY0MTgxMTkxMEQzNDkKUldSSjB4QVpnVUZtOXR1SWZydTN5ZVl6dTMvZnZVb01nTS9aaTFEendaWEpXSW44Wk1rcjIrQ2cK"
    }
  }
}
